{
  "name": "tether-monorepo",
  "version": "2.8.12",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:server": "bun --cwd apps/server dev",
    "dev:mobile": "bun --cwd apps/mobile start",
    "build:server": "bun --cwd apps/server build",
    "start:server": "bun --cwd apps/server start",
    "lint": "biome check && bun --cwd apps/server typecheck && bun --cwd apps/mobile typecheck && bun --cwd apps/desktop typecheck",
    "dev:desktop": "bun --cwd apps/desktop run tauri:dev",
    "format": "biome check --write",
    "gen:proto": "bunx --bun @bufbuild/buf@1.60.0 generate",
    "docs:dev": "vitepress dev docs",
    "docs:build": "cp install.sh docs/public/install.sh && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:desktop": "bun --cwd apps/desktop run test"
  },
  "dependencies": {
    "bun-types": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "typescript": "~7.0.2",
    "vitepress": "1.6.4"
  },
  "patchedDependencies": {
    "expo-modules-jsi@57.0.5": "patches/expo-modules-jsi@57.0.5.patch"
  }
}
