{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // jest globals for the component specs; bun's own test globals come from
    // bun-types, which the pure-logic *.test.ts files are excluded from below.
    "types": ["jest"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "exclude": ["src-tauri", "dist", "scripts", "terminal-renderer", "**/*.test.ts"]
}
