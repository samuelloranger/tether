{
  "name": "tether",
  "version": "4.0.2",
  "private": true,
  "type": "module",
  "bin": {
    "tether": "./src/server/main.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "build": "bun run build:binary",
    "start": "./dist/tether serve",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run build:ffi",
    "test": "bun test --parallel",
    "lint": "biome check",
    "format": "biome check --write",
    "build:binary": "bun run build:ffi && bun build --compile --minify --define process.env.TETHER_VERSION=\\\"$TETHER_VERSION\\\" --define process.env.TETHER_DEFAULT_PUSH_RELAY_URL=\\\"$TETHER_PUSH_RELAY_URL\\\" --outfile dist/tether src/server/main.ts",
    "build:ffi": "bun ../../scripts/build-ffi.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "hono": "^4.13.3",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "^1.4.0",
    "@types/qrcode": "^1.5.6"
  }
}
