{
  "name": "tether",
  "version": "2.8.8",
  "private": true,
  "type": "module",
  "bin": {
    "tether": "./src/server/main.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "build": "bun run build:binary",
    "start": "./dist/tether serve",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel",
    "lint": "biome check",
    "format": "biome check --write",
    "build:binary": "bun build --compile --minify --define process.env.TETHER_VERSION=\\\"${TETHER_VERSION:-dev}\\\" --define process.env.TETHER_DEFAULT_PUSH_RELAY_URL=\\\"${TETHER_PUSH_RELAY_URL:-https://tether-relay.samlo.cloud}\\\" --outfile dist/tether src/server/main.ts"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "^1.4.0"
  }
}
