{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core permissions for the native Tether desktop window.",
  "windows": ["main"],
    "permissions": [
      "core:default",
      "clipboard-manager:allow-read-text",
      "clipboard-manager:allow-write-text",
