{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tether",
  "version": "4.0.4",
  "identifier": "cloud.samlo.tether",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tether",
        "width": 1000,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http: https: ws: wss:",
        "frame-src": "http: https:",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http: https: ws: wss:",
        "frame-src": "http: https:",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-eval'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tether"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/samuelloranger/tether/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5NTY5N0UyQjAxOTQwNApSV1FFbEFFcmZtbVZDL3RZUmJNcGlZQVNhOXZqL1NQaVA3UXdiMkc5cXBhdHd1UVFNMjcrSHNaOAo="
    }
  }
}
