{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "*.json",
      "!apps/**/dist",
      "!apps/**/node_modules",
      "!apps/mobile/src/*.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noTemplateCurlyInString": "off"
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": { "maxLines": 60, "skipBlankLines": true, "skipIifes": true }
        }
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": { "maxLines": 400 }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/src/tether/use*.ts", "apps/mobile/src/tether/use*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": { "maxLines": 150 }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/mobile/src/**/*.tsx",
        "!apps/mobile/src/tether/use*.tsx",
        "!apps/mobile/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "warn",
              "options": { "maxLines": 500 }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/**/*.test.ts",
        "apps/**/*.test.tsx",
        "apps/**/*.spec.ts",
        "apps/**/*.spec.tsx",
        "apps/**/__tests__/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/mobile/src/CodeHighlight.tsx",
        "apps/mobile/src/DiffLines.tsx",
        "apps/mobile/src/SideBySideDiff.tsx",
        "apps/mobile/src/DiffView.tsx",
        "apps/mobile/src/SelectionView.tsx",
        "apps/mobile/src/TermRow.tsx",
        "apps/mobile/src/SessionModals.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/mobile/src/FileViewer.tsx",
        "apps/mobile/src/SessionDrawer.tsx",
        "apps/mobile/src/ConnectionBanner.tsx",
        "apps/mobile/src/useTetherApp.tsx",
        "apps/mobile/src/TerminalScreen.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/links.ts", "apps/mobile/src/xtermPolyfill.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    }
  ]
}
