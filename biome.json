{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "*.json",
      "!apps/**/dist",
      "!apps/**/node_modules",
      "!apps/mobile/src/*.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noTemplateCurlyInString": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/mobile/src/CodeHighlight.tsx",
        "apps/mobile/src/DiffLines.tsx",
        "apps/mobile/src/SideBySideDiff.tsx",
        "apps/mobile/src/GitDrawer.tsx",
        "apps/mobile/src/GitReview.tsx",
        "apps/mobile/src/SelectionView.tsx",
        "apps/mobile/src/TermRow.tsx",
        "apps/mobile/src/SessionModals.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/mobile/src/FileViewer.tsx",
        "apps/mobile/src/SessionDrawer.tsx",
        "apps/mobile/src/ConnectionBanner.tsx",
        "apps/mobile/src/useTetherApp.tsx",
        "apps/mobile/src/TerminalScreen.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/mobile/src/links.ts", "apps/mobile/src/xtermPolyfill.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    }
  ]
}
