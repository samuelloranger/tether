# Dependency directories
node_modules/
apps/**/node_modules/

# Build outputs
dist/
apps/server/dist/

# Local databases and runtime state
config/*.db
config/*.db-journal

# Environment files
.env
.env.local

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Expo build folders
apps/mobile/.expo/
apps/mobile/ios/
apps/mobile/android/

# Root-level runtime state (rcfile/db written when server runs from repo root)
/config/

# Runtime config dir (db + generated shell rcfiles). Written relative to the
# server's cwd, so match it at any depth — a stray cwd once committed six
# generated files under src/server/config.
apps/server/**/config/

# CodeGraph local index
.codegraph/

# VitePress build artifacts
docs/.vitepress/dist/
docs/.vitepress/cache/

# Generated AltStore source (built from altstore.base.json + GitHub Releases;
# published to https://samlo.cloud/tether/altstore.json — never commit)
/altstore.json

# generated: canonical install.sh / install.ps1 copied in at docs build
docs/public/install.sh
docs/public/install.ps1
apps/mobile/dist/

# Tauri
apps/mobile/src-tauri/target/
apps/mobile/src-tauri/gen/

# jscpd duplication reports (local audit output)
.jscpd-report/

# Superpowers skill session state
.superpowers/

# Codex local tooling (contains absolute local paths)
.codex/

# Playwright MCP scratch output
.playwright-mcp/

# scratch dir from scripts/build-updater-manifest.ts
.updater-sigs/

# Rust build artifacts
**/target/

# Generated by scripts/build-xcframework.sh (macOS only)
clients/apple/TetherKit/Frameworks/
clients/apple/TetherKit/Sources/TetherFFIBindings/

# SwiftPM build output
clients/apple/TetherKit/.build/

# Generated by scripts/build-ffi.ts: native cdylib embedded into the server binary
apps/server/src/server/noiseNativeLib

# Local design-critique artifacts (impeccable skill)
.impeccable/
