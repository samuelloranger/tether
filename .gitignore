# Dependency directories
node_modules/
apps/**/node_modules/

# Build outputs
dist/

# Environment files
.env
.env.local

# Local runtime state (leftover from old server dev-runs; never commit a db)
/config/

# Generated docs site (VitePress build output — not tracked)
docs/

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# CodeGraph local index
.codegraph/

# jscpd duplication reports (local audit output)
.jscpd-report/

# Superpowers skill session state
.superpowers/

# Codex local tooling (contains absolute local paths)
.codex/

# Playwright MCP scratch output
.playwright-mcp/

# Rust build artifacts
**/target/

# SSH transport XCFrameworks are prebuilt deps (committed); TetherFFI + its
# generated bindings are produced by scripts/build-xcframework.sh (not committed).
clients/apple/TetherKit/Frameworks/*
!clients/apple/TetherKit/Frameworks/SSH/
!clients/apple/TetherKit/Frameworks/SSH/**
clients/apple/TetherKit/Sources/TetherFFIBindings/

# SwiftPM build output
clients/apple/TetherKit/.build/

# tether-notify host CLI local state
.tether-notify/

# Local design-critique artifacts (impeccable skill)
.impeccable/
.worktrees/
