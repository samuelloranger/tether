import { Tokens, Motion } from "tokens.slint";
import { ConfirmDialog, GhostButton, PrimaryButton, SecondaryButton, IconButton, Linger } from "components.slint";
import { HistoryOverlay, PaletteOverlay, HistoryVm, PaletteVm } from "extras.slint";
import { AgentVm, AgentChip, AgentBanner, AgentSheet, Heat, TextDot } from "agents.slint";
import { GitVm, GitSidePanel, GitOverlays } from "git.slint";
import { ChatVm, ChatPane, ChatSidebarRow, ChatTitleBlock, ChatStatus, ChatOverlays } from "chat.slint";

export struct TermTab {
    name: string, cwd: string, active: bool, attention: bool,
    has-progress: bool, progress: float, progress-state: int,
    agent-state: int, agent-label: string,   // -1 when the session reports no agent
}

export global TerminalVm {
    in property <string> machine;
    in property <string> session;
    in property <string> session-cwd;    // the active session's folder leaf; empty for ~
    in property <int> sidebar;           // 0 docked, 1 hidden, 2 over the content
    in property <string> word;
    in property <int> lamp;              // 0 warning, 1 success, 2 danger
    in property <int> lamp-flash-seq;
    in property <[TermTab]> tabs;
    in property <color> well-color: #1E1E2E;
    in property <image> frame;
    in property <int> frame-width;
    in property <int> frame-height;
    in property <bool> empty;
    in property <string> empty-title;
    in property <bool> naming;
    in property <string> naming-text;
    in property <string> kill-name;
    in property <bool> disconnected;
    in property <string> send-capsule;
    in property <string> session-error;
    in property <bool> has-progress;
    in property <float> progress;
    in property <int> progress-state;    // 0 normal, 1 error, 2 indeterminate, 3 paused
    in property <string> tooltip;
    in property <length> pointer-x;
    in property <length> pointer-y;
    in property <bool> hand-cursor;
    in property <string> menu-link;
    in property <bool> menu-copy;        // the link menu's second item: Copy (a selection exists) or Paste
    in property <string> menu-tab;
    in property <length> menu-x;
    in property <length> menu-y;
    in property <bool> search-open;
    in property <string> search-query;
    in property <string> search-label;
    in property <int> search-focus-seq;
    in-out property <bool> search-focused;
    callback back();
    callback send-file();
    callback find();
    callback settings();
    callback history();
    callback snippets();
    callback select-tab(string);
    callback kill-tab(string);
    callback tab-menu(string, length, length);
    callback new-session();
    callback commit-name(string);
    callback cancel-name();
    callback kill-from-menu();
    callback kill-confirmed();
    callback kill-cancelled();
    callback close-menu();
    callback copy-link();
    callback menu-primary();
    callback reconnect();
    callback retry-session();
    callback home();
    callback well-resized(length, length);
    callback toggle-sidebar();
    callback sidebar-dismiss();
    // kind: 0 down, 1 up, 2 move. button: 0 left, 1 right, 2 middle, 3 none.
    callback pointer(int, int, bool, bool, bool, length, length);
    callback wheel(length, bool, bool, bool, length, length);
    callback search-edited(string);
    callback search-step(bool);
    callback search-close();
}

component SearchBar inherits Rectangle {
    property <int> focus-seq: TerminalVm.search-focus-seq;
    changed focus-seq => { field.focus(); field.select-all(); }
    changed visible => { if (!self.visible) { field.clear-focus(); } }
    width: 360px;
    height: 38px;
    background: Tokens.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: field.has-focus ? Tokens.accent : Tokens.border;
    animate border-color { duration: Motion.fast; easing: ease-out; }
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000080;
    drop-shadow-offset-y: 4px;
    public function release() { field.clear-focus(); }
    HorizontalLayout {
        padding-left: 10px; padding-right: 4px; spacing: 4px;
        field := TextInput {
            horizontal-stretch: 1;
            text: TerminalVm.search-query;
            color: Tokens.text; font-size: 12.5px; vertical-alignment: center;
            single-line: true;
            changed has-focus => { TerminalVm.search-focused = self.has-focus; }
            edited => { TerminalVm.search-edited(self.text); }
            key-pressed(e) => {
                if (e.text == Key.Escape) { TerminalVm.search-close(); return accept; }
                if (e.text == Key.Return) { TerminalVm.search-step(!e.modifiers.shift); return accept; }
                reject
            }
            Text {
                visible: parent.text == "";
                text: "Find in scrollback";
                color: Tokens.text-faint; font-size: 12.5px; vertical-alignment: center;
            }
        }
        Text { text: TerminalVm.search-label; color: Tokens.text-secondary; font-size: 11.5px; vertical-alignment: center; horizontal-alignment: right; min-width: 64px; }
        VerticalLayout { alignment: center; IconButton { flat: true; size: 26px; icon: @image-url("icons/arrow-up.svg"); tooltip: "Older · Enter"; clicked => { TerminalVm.search-step(true); } } }
        VerticalLayout { alignment: center; IconButton { flat: true; size: 26px; icon: @image-url("icons/arrow-down.svg"); tooltip: "Newer · Shift+Enter"; clicked => { TerminalVm.search-step(false); } } }
        VerticalLayout { alignment: center; IconButton { flat: true; size: 26px; icon: @image-url("icons/close.svg"); tooltip: "Close · Esc"; clicked => { TerminalVm.search-close(); } } }
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked();
    height: 32px;
    border-radius: 7px;
    background: touch.has-hover ? (root.danger ? Tokens.danger.with-alpha(0.12) : Tokens.raised) : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }
    Text {
        x: 10px;
        text: root.text;
        color: root.danger ? Tokens.danger : Tokens.text;
        font-size: 13px;
        vertical-alignment: center;
        height: parent.height;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Lamp inherits Rectangle {
    in property <int> lamp;
    in property <bool> flashing;
    width: 8px; height: 8px; border-radius: 4px;
    background: lamp == 0 ? Tokens.warning : lamp == 1 ? Tokens.success : Tokens.danger;
    opacity: flashing ? 0.25 : 1;
    animate opacity { duration: 90ms; }
}

component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <int> state;
    height: 2px;
    Rectangle {
        x: 0; height: parent.height;
        // Indeterminate is a steady partial bar: the chrome has no looping motion (DESIGN.md).
        width: state == 2 ? parent.width * 0.4 : parent.width * value;
        background: state == 1 ? Tokens.danger : state == 3 ? Tokens.warning : Tokens.accent;
        opacity: state == 2 ? 0.6 : 1;
    }
}

component SideIcon inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: touch.has-hover ? Tokens.surface-hover : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }
    Image {
        source: root.icon;
        colorize: touch.has-hover ? Tokens.text : Tokens.text-secondary;
        animate colorize { duration: Motion.fast; easing: ease-out; }
        width: 15px;
        height: 15px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SidebarAction inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> keys;
    callback clicked();
    height: 30px;
    border-radius: 8px;
    background: touch.has-hover ? Tokens.surface-hover : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 9px;
        VerticalLayout { alignment: center; Image { source: root.icon; colorize: touch.has-hover ? Tokens.text : Tokens.text-secondary; width: 14px; height: 14px; } }
        Text { horizontal-stretch: 1; text: root.text; font-size: 12.5px; color: touch.has-hover ? Tokens.text : Tokens.text-secondary; vertical-alignment: center; }
        if root.keys != "": Text { text: root.keys; font-size: 10.5px; color: Tokens.text-faint; vertical-alignment: center; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SectionHeader inherits HorizontalLayout {
    in property <string> text;
    callback add(length, length);
    height: 26px;
    padding-left: 8px;
    padding-top: 6px;
    Text { horizontal-stretch: 1; text: root.text; font-size: 10.5px; font-weight: 650; letter-spacing: 0.6px; color: Tokens.text-faint; vertical-alignment: center; }
    plus := Rectangle {
        width: 22px;
        border-radius: 6px;
        background: plus-touch.has-hover ? Tokens.surface-hover : transparent;
        animate background { duration: Motion.fast; easing: ease-out; }
        Image { source: @image-url("icons/plus.svg"); colorize: plus-touch.has-hover ? Tokens.text : Tokens.text-faint; width: 12px; height: 12px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        plus-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.add(self.absolute-position.x, self.absolute-position.y + self.height + 4px); }
        }
    }
}

// One terminal session in the sidebar's Terminals section.
component TermRow inherits Rectangle {
    in property <TermTab> tab;
    callback picked();
    height: 30px;
    border-radius: 8px;
    background: root.tab.active ? Tokens.raised : touch.has-hover ? Tokens.surface-hover : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout { alignment: center; Image { source: @image-url("icons/terminal.svg"); colorize: root.tab.active ? Tokens.text : Tokens.text-secondary; width: 14px; height: 14px; } }
        name := Text {
            horizontal-stretch: 1;
            text: root.tab.name;
            overflow: elide;
            color: root.tab.active || touch.has-hover ? Tokens.text : Tokens.text-secondary;
            animate color { duration: Motion.fast; easing: ease-out; }
            font-size: 12.5px;
            font-weight: root.tab.active ? 600 : 500;
            vertical-alignment: center;
        }
        // The home directory says nothing; another directory reads as a quiet suffix.
        if root.tab.cwd != "" && root.tab.cwd != "~" && !touch.has-hover && !close-touch.has-hover: Text {
            text: root.tab.cwd;
            max-width: 90px;
            overflow: elide;
            color: Tokens.text-faint;
            font-size: 11px;
            vertical-alignment: center;
        }
        if root.tab.attention: TextDot { ink: Tokens.warning; line-height: name.preferred-height; }
        if root.tab.agent-state >= 0: AgentChip { state: root.tab.agent-state; label: root.tab.agent-label; }
        if touch.has-hover || close-touch.has-hover: Rectangle { width: 16px; }
    }
    if root.tab.has-progress: ProgressBar {
        x: 8px;
        y: parent.height - 2px;
        width: parent.width - 16px;
        value: root.tab.progress;
        state: root.tab.progress-state;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                TerminalVm.tab-menu(root.tab.name, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { TerminalVm.select-tab(root.tab.name); root.picked(); }
    }
    if touch.has-hover || close-touch.has-hover: Rectangle {
        x: parent.width - 8px - 16px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 5px;
        background: close-touch.has-hover ? Tokens.border : transparent;
        animate background { duration: Motion.fast; easing: ease-out; }
        Image { source: @image-url("icons/close.svg"); colorize: close-touch.has-hover ? Tokens.text : Tokens.text-secondary; width: 10px; height: 10px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    }
    // After the row's own TouchArea so it receives the click on the close mark.
    close-touch := TouchArea {
        x: parent.width - 8px - 16px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        mouse-cursor: pointer;
        clicked => { TerminalVm.kill-tab(root.tab.name); }
    }
}

component Sidebar inherits Rectangle {
    property <bool> flashing;
    property <int> flash-seq: TerminalVm.lamp-flash-seq;
    changed flash-seq => { flashing = true; }
    Timer { interval: 180ms; running: flashing; triggered => { flashing = false; } }
    callback picked();
    width: 248px;
    background: Tokens.surface;
    Rectangle { x: parent.width - 1px; width: 1px; background: Tokens.border; }
    VerticalLayout {
        padding: 8px;
        padding-right: 9px;
        spacing: 2px;
        HorizontalLayout {
            padding-left: 8px;
            padding-bottom: 8px;
            spacing: 9px;
            VerticalLayout { alignment: center; Lamp { lamp: TerminalVm.lamp; flashing: root.flashing; } }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text { text: TerminalVm.machine; color: Tokens.text; font-size: 13.5px; font-weight: 650; overflow: elide; }
                Text {
                    text: TerminalVm.word;
                    font-size: 11.5px;
                    color: TerminalVm.lamp == 0 ? Tokens.warning : TerminalVm.lamp == 1 ? Tokens.success : Tokens.danger;
                }
            }
            VerticalLayout { alignment: center; SideIcon { icon: @image-url("icons/sidebar.svg"); tooltip: "Hide sidebar · Ctrl+Shift+B"; clicked => { TerminalVm.toggle-sidebar(); } } }
        }
        SidebarAction { icon: @image-url("icons/chat.svg"); text: "New chat"; keys: "Ctrl+Shift+N"; clicked => { ChatVm.new-chat(0); root.picked(); } }
        SidebarAction { icon: @image-url("icons/terminal.svg"); text: "New terminal"; keys: "Ctrl+Shift+T"; clicked => { TerminalVm.new-session(); } }
        Flickable {
            vertical-stretch: 1;
            viewport-height: rows.preferred-height;
            rows := VerticalLayout {
                alignment: start;
                spacing: 2px;
                SectionHeader {
                    text: "TERMINALS";
                    add(x, y) => { TerminalVm.new-session(); }
                }
                for tab in TerminalVm.tabs: TermRow { tab: tab; picked => { root.picked(); } }
                if TerminalVm.naming: Rectangle {
                    height: 30px;
                    border-radius: 8px;
                    background: Tokens.raised;
                    border-width: 1px;
                    border-color: Tokens.accent;
                    TextInput {
                        x: 30px; width: parent.width - 38px;
                        text: TerminalVm.naming-text;
                        color: Tokens.text; font-size: 12.5px; font-weight: 600; vertical-alignment: center;
                        single-line: true;
                        init => { self.focus(); self.select-all(); }
                        accepted => { TerminalVm.commit-name(self.text); }
                        key-pressed(e) => {
                            if (e.text == Key.Escape) { TerminalVm.cancel-name(); return accept; }
                            reject
                        }
                    }
                    Image { x: 8px; y: (parent.height - self.height) / 2; source: @image-url("icons/terminal.svg"); colorize: Tokens.accent; width: 14px; height: 14px; }
                }
                if TerminalVm.tabs.length == 0 && !TerminalVm.naming: Text {
                    x: 8px;
                    height: 26px;
                    text: "No terminals running";
                    font-size: 11.5px;
                    color: Tokens.text-faint;
                    vertical-alignment: center;
                }
                SectionHeader {
                    text: "CHATS";
                    add(x, y) => {
                        ChatVm.add-menu-x = x;
                        ChatVm.add-menu-y = y;
                        ChatVm.add-menu = true;
                    }
                }
                for chat in ChatVm.tabs: ChatSidebarRow { tab: chat; picked => { root.picked(); } }
                if ChatVm.tabs.length == 0: Text {
                    x: 8px;
                    height: 26px;
                    text: "No chats on this host yet";
                    font-size: 11.5px;
                    color: Tokens.text-faint;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 1px; background: Tokens.border; }
        Rectangle { height: 4px; }
        SidebarAction { icon: @image-url("icons/back.svg"); text: "Hosts"; clicked => { TerminalVm.back(); } }
        SidebarAction { icon: @image-url("icons/gear.svg"); text: "Settings"; clicked => { TerminalVm.settings(); } }
    }
}

// The one header over a terminal or a chat.
component PaneHeader inherits Rectangle {
    in property <bool> docked;
    property <bool> flashing;
    property <int> flash-seq: TerminalVm.lamp-flash-seq;
    changed flash-seq => { flashing = true; }
    Timer { interval: 180ms; running: flashing; triggered => { flashing = false; } }
    property <string> prefix: root.docked ? "" : TerminalVm.machine + " \u{00B7} ";
    height: 52px;
    background: Tokens.background;
    HorizontalLayout {
        padding-left: root.docked ? 16px : 8px;
        padding-right: 8px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 8px;
        if !root.docked: SideIcon { icon: @image-url("icons/sidebar.svg"); tooltip: "Show sidebar · Ctrl+Shift+B"; clicked => { TerminalVm.toggle-sidebar(); } }
        if !root.docked: VerticalLayout { alignment: center; Lamp { lamp: TerminalVm.lamp; flashing: root.flashing; } }
        // The lamp is never the only signal: the word the sidebar shows comes here while it is closed.
        if !root.docked: Text {
            text: TerminalVm.word;
            font-size: 11.5px;
            color: TerminalVm.lamp == 0 ? Tokens.warning : TerminalVm.lamp == 1 ? Tokens.success : Tokens.danger;
            vertical-alignment: center;
        }
        if ChatVm.active: ChatTitleBlock { horizontal-stretch: 1; prefix: root.prefix; }
        if !ChatVm.active: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: TerminalVm.session; color: Tokens.text; font-size: 14px; font-weight: 600; overflow: elide; }
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: root.prefix + (TerminalVm.session-cwd != "" ? TerminalVm.session-cwd : "~");
                    font-family: Tokens.mono-font;
                    color: Tokens.text-faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                if AgentVm.line != "": Text {
                    horizontal-stretch: 1;
                    text: "\u{00B7} " + AgentVm.line;
                    font-size: 11.5px;
                    overflow: elide;
                    color: AgentVm.line-state >= 0 ? Heat.ink(AgentVm.line-state) : Tokens.text-faint;
                    vertical-alignment: center;
                }
            }
        }
        if ChatVm.active: ChatStatus { horizontal-stretch: 0; }
        if !ChatVm.active: IconButton { icon: @image-url("icons/search.svg"); tooltip: "Find in scrollback · Ctrl+Shift+F"; active: TerminalVm.search-open; clicked => { TerminalVm.find(); } }
        if !ChatVm.active: IconButton { icon: @image-url("icons/snippets.svg"); tooltip: "Snippets · Ctrl+Shift+P"; active: PaletteVm.open; clicked => { TerminalVm.snippets(); } }
        if !ChatVm.active: IconButton { icon: @image-url("icons/history.svg"); tooltip: "History · Ctrl+Shift+H"; active: HistoryVm.open; clicked => { TerminalVm.history(); } }
        // A chat attaches files from its composer's + instead.
        if !ChatVm.active: IconButton { icon: @image-url("icons/upload.svg"); tooltip: "Send file"; clicked => { TerminalVm.send-file(); } }
        IconButton { icon: @image-url("icons/git.svg"); tooltip: "Git"; active: GitVm.open; clicked => { GitVm.toggle(); } }
        if !root.docked: IconButton { icon: @image-url("icons/gear.svg"); tooltip: "Settings"; clicked => { TerminalVm.settings(); } }
    }
    // A chat's context in use, as a 3 px rule under the header; otherwise a hairline.
    Rectangle {
        y: parent.height - self.height;
        height: ChatVm.active && ChatVm.context >= 0 ? 3px : 1px;
        background: Tokens.border;
        if ChatVm.active && ChatVm.context >= 0: Rectangle {
            x: 0;
            width: parent.width * clamp(ChatVm.context, 0, 1);
            background: Tokens.accent;
        }
    }
}

export component TerminalPage inherits Rectangle {
    property <bool> docked: TerminalVm.sidebar == 0;
    // Follows the slide, so the git panel's cap and the chat overlays move with the sidebar.
    property <length> side-w: 248px * root.side-t;
    background: Tokens.background;
    // The docked sidebar and the git panel grow and shrink with the terminal beside them. The grid
    // redraws each frame, but the PTY only hears the settled size (see `relayout`), so a slide is one
    // SIGWINCH. A factor, not the width, is animated, so dragging the git panel's edge stays instant.
    property <float> side-t: root.docked ? 1 : 0;
    animate side-t { duration: Motion.slow; easing: ease-in-out; }
    property <float> git-t: GitVm.open ? 1 : 0;
    animate git-t { duration: Motion.slow; easing: ease-in-out; }
    over := Linger { open: TerminalVm.sidebar == 2; duration: Motion.slow; }
    HorizontalLayout {
    if root.side-t > 0: Rectangle {
        width: 248px * root.side-t;
        clip: true;
        Sidebar { x: parent.width - self.width; }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        PaneHeader { docked: root.docked; }
        if TerminalVm.has-progress: ProgressBar { value: TerminalVm.progress; state: TerminalVm.progress-state; }
        if AgentVm.banner != "": AgentBanner { }
        content := HorizontalLayout {
        vertical-stretch: 1;
        Rectangle {
            horizontal-stretch: 1;
            background: TerminalVm.well-color;
            changed width => { TerminalVm.well-resized(self.width, self.height); }
            changed height => { TerminalVm.well-resized(self.width, self.height); }
            init => { TerminalVm.well-resized(self.width, self.height); }
            if TerminalVm.session-error == "": Image {
                x: 0; y: 0;
                width: TerminalVm.frame-width * 1phx;
                height: TerminalVm.frame-height * 1phx;
                source: TerminalVm.frame;
                image-rendering: pixelated;
            }
            if TerminalVm.session-error != "": VerticalLayout {
                alignment: center; spacing: 8px;
                Text { text: TerminalVm.session-error; color: Tokens.text; font-size: 14px; horizontal-alignment: center; }
                HorizontalLayout { alignment: center; PrimaryButton { text: "Retry"; clicked => { TerminalVm.retry-session(); } } }
            }
            TouchArea {
                mouse-cursor: TerminalVm.hand-cursor ? MouseCursor.pointer : MouseCursor.text;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && TerminalVm.search-open) { search.release(); }
                    TerminalVm.pointer(
                        e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.up ? 1 : 2,
                        e.button == PointerEventButton.left ? 0 : e.button == PointerEventButton.right ? 1 : e.button == PointerEventButton.middle ? 2 : 3,
                        e.modifiers.shift, e.modifiers.control, e.modifiers.alt, self.mouse-x, self.mouse-y);
                }
                scroll-event(e) => {
                    TerminalVm.wheel(e.delta-y, e.modifiers.shift, e.modifiers.control, e.modifiers.alt, self.mouse-x, self.mouse-y);
                    accept
                }
            }
            if TerminalVm.empty: VerticalLayout {
                alignment: center; spacing: 8px;
                Text { text: TerminalVm.empty-title; color: Tokens.text; font-size: 18px; horizontal-alignment: center; }
                Text { text: "Nothing runs until you start one."; color: Tokens.text-secondary; font-size: 13px; horizontal-alignment: center; }
                HorizontalLayout { alignment: center; PrimaryButton { text: "New session"; clicked => { TerminalVm.new-session(); } } }
            }
            if TerminalVm.disconnected: Rectangle {
                y: parent.height - 64px; height: 44px; width: capsule.preferred-width; x: (parent.width - self.width) / 2;
                background: Tokens.surface; border-radius: 22px; border-width: 1px; border-color: Tokens.border;
                capsule := HorizontalLayout {
                    padding: 6px; spacing: 6px;
                    PrimaryButton { text: "Reconnect"; clicked => { TerminalVm.reconnect(); } }
                    SecondaryButton { text: "Back to Home"; clicked => { TerminalVm.home(); } }
                }
            }
            search := SearchBar {
                visible: TerminalVm.search-open;
                x: parent.width - self.width - 12px;
                y: 10px;
            }
            if ChatVm.active: ChatPane { }
            // After the chat pane, so a send started from a chat shows its progress and failure.
            if TerminalVm.send-capsule != "" && !TerminalVm.disconnected: Rectangle {
                y: parent.height - 56px; height: 32px; width: send-text.preferred-width + 32px; x: (parent.width - self.width) / 2;
                background: Tokens.surface; border-radius: 16px; border-width: 1px; border-color: Tokens.border;
                send-text := Text { text: TerminalVm.send-capsule; color: Tokens.text; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
            }
            if TerminalVm.tooltip != "" && !ChatVm.active: Rectangle {
                x: TerminalVm.pointer-x + 12px; y: TerminalVm.pointer-y + 16px;
                width: tip.preferred-width + 16px; height: 24px;
                background: Tokens.surface; border-radius: 6px; border-width: 1px; border-color: Tokens.border;
                tip := Text { text: TerminalVm.tooltip; color: Tokens.text; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
            }
        }
        if root.git-t > 0: Rectangle {
            width: panel.width * root.git-t;
            clip: true;
            panel := GitSidePanel { x: 0; max-panel-width: (root.width - root.side-w) / 2; }
        }
        }
    }
    }
    if over.alive: Rectangle {
        Rectangle {
            background: #00000066;
            opacity: over.shown ? 1 : 0;
            animate opacity { duration: Motion.base; easing: ease-out; }
            TouchArea { enabled: over.shown; clicked => { TerminalVm.sidebar-dismiss(); } }
        }
        Sidebar {
            x: over.shown ? 0 : -self.width;
            animate x { duration: Motion.slow; easing: ease-out; }
            height: parent.height;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000099;
            picked => { TerminalVm.sidebar-dismiss(); }
        }
    }
    if TerminalVm.menu-link != "" || TerminalVm.menu-tab != "": TouchArea {
        clicked => { TerminalVm.close-menu(); }
        menu := Rectangle {
            x: TerminalVm.menu-x; y: TerminalVm.menu-y - self.lift; width: 180px; height: items.preferred-height;
            property <bool> shown;
            // Only the entrance glides; a menu reopened elsewhere jumps there.
            property <length> lift: menu.shown ? 0 : 4px;
            opacity: menu.shown ? 1 : 0;
            animate opacity, lift { duration: Motion.fast; easing: ease-out; }
            Timer { interval: 30ms; running: !menu.shown; triggered => { menu.shown = true; } }
            background: Tokens.surface; border-radius: 10px; border-width: 1px; border-color: Tokens.border;
            drop-shadow-blur: 16px; drop-shadow-color: #00000080; drop-shadow-offset-y: 4px;
            items := VerticalLayout {
                padding: 4px;
                if TerminalVm.menu-tab != "": MenuItem { text: "Kill session"; danger: true; clicked => { TerminalVm.kill-from-menu(); } }
                if TerminalVm.menu-link != "": MenuItem { text: "Copy link"; clicked => { TerminalVm.copy-link(); } }
                if TerminalVm.menu-link != "": MenuItem { text: TerminalVm.menu-copy ? "Copy" : "Paste"; clicked => { TerminalVm.menu-primary(); } }
            }
        }
    }
    if ChatVm.add-menu: TouchArea {
        clicked => { ChatVm.add-menu = false; }
        add := Rectangle {
            x: min(ChatVm.add-menu-x, root.width - self.width - 8px);
            y: ChatVm.add-menu-y - self.lift;
            property <bool> shown;
            // Only the entrance glides; a menu reopened elsewhere jumps there.
            property <length> lift: add.shown ? 0 : 4px;
            opacity: add.shown ? 1 : 0;
            animate opacity, lift { duration: Motion.fast; easing: ease-out; }
            Timer { interval: 30ms; running: !add.shown; triggered => { add.shown = true; } }
            width: 190px;
            height: add-items.preferred-height;
            background: Tokens.surface; border-radius: 10px; border-width: 1px; border-color: Tokens.border;
            drop-shadow-blur: 16px; drop-shadow-color: #00000080; drop-shadow-offset-y: 4px;
            add-items := VerticalLayout {
                padding: 4px;
                MenuItem { text: "New session"; clicked => { ChatVm.add-menu = false; TerminalVm.new-session(); } }
                MenuItem { text: "New chat\u{2026}"; clicked => { ChatVm.add-menu = false; ChatVm.new-chat(0); } }
                MenuItem { text: "Continue a chat\u{2026}"; clicked => { ChatVm.add-menu = false; ChatVm.new-chat(1); } }
            }
        }
    }
    // Over the sidebar too, so the session it shows cannot change underneath it.
    history := Linger { open: HistoryVm.open; }
    palette := Linger { open: PaletteVm.open; }
    kill := Linger { open: TerminalVm.kill-name != ""; }
    if history.alive: HistoryOverlay {
        shown: history.shown;
        width: parent.width;
        height: parent.height;
        well: TerminalVm.well-color;
    }
    if palette.alive: PaletteOverlay {
        shown: palette.shown;
        width: parent.width;
        height: parent.height;
    }
    if AgentVm.open: AgentSheet { }
    if kill.alive: ConfirmDialog {
        shown: kill.shown;
        title: "Kill session " + TerminalVm.kill-name + "?";
        body: "Everything running in it stops. This can't be undone.";
        action: "Kill session";
        confirmed => { TerminalVm.kill-confirmed(); }
        cancelled => { TerminalVm.kill-cancelled(); }
    }
    GitOverlays { }
    ChatOverlays { left: root.side-w; }
}
