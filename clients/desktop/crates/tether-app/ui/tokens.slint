export global Tokens {
    in property <bool> dark: true;
    in property <color> background: #000000;
    in property <color> surface: #141414;
    in property <color> surface-hover: #1a1a1a;
    in property <color> raised: #202020;
    in property <color> input: #0a0a0a;
    in property <color> border: #2a2a2a;
    in property <color> text: #f2f2f2;
    in property <color> text-secondary: #ababab;
    in property <color> text-faint: #8d8d8d;
    in property <color> placeholder: #808080;
    in property <color> accent: #7c8cf8;
    in property <color> on-accent: #000000;
    in property <color> success: #6ee7a8;
    in property <color> warning: #f2b34c;
    in property <color> danger: #ff7050;
    in property <color> on-danger: #1a0a07;
    in property <color> well: #000000;
    in property <string> ui-font: "Segoe UI Variable Text";
    out property <string> mono-font: "Cascadia Mono";
    out property <length> radius-card: 16px;
    out property <length> radius-control: 11px;
    out property <length> radius-button: 12px;
}

// One timing scale for every transition: hover and press colours, then panels and dialogs.
export global Motion {
    out property <duration> fast: 110ms;
    out property <duration> base: 170ms;
    out property <duration> slow: 240ms;
    // How far a dialog or panel travels as it arrives.
    out property <length> rise: 8px;
}
