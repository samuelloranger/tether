export global Tokens {
    in property <bool> dark: true;
    in property <color> background: #08080e;
    in property <color> surface: #12121d;
    in property <color> surface-hover: #161624;
    in property <color> raised: #191926;
    in property <color> input: #0b0b13;
    in property <color> border: #232333;
    in property <color> text: #edeef6;
    in property <color> text-secondary: #9797ac;
    in property <color> text-faint: #8b8ba3;
    in property <color> placeholder: #5c5c73;
    in property <color> accent: #7c8cf8;
    in property <color> on-accent: #08080e;
    in property <color> success: #6ee7a8;
    in property <color> warning: #f2b34c;
    in property <color> danger: #ff7050;
    in property <color> on-danger: #1a0a07;
    in property <color> well: #1e1e2e;
    in property <string> ui-font: "Segoe UI Variable Text";
    out property <string> mono-font: "Cascadia Mono";
    out property <length> radius-card: 16px;
    out property <length> radius-control: 11px;
    out property <length> radius-button: 12px;
}
