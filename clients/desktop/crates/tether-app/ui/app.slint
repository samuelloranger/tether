import { ConfirmDialog, Reveal } from "components.slint";
import { HomePage } from "home.slint";
import { ServerFormPage, KeyGeneratePage, KeyMaterialPage } from "forms.slint";
import { SettingsPage } from "settings.slint";
import { SshImportPage } from "ssh_import.slint";
import { SchemePickerPage, FontPickerPage } from "pickers.slint";
import { TerminalPage, TerminalVm, TermTab } from "terminal.slint";
import { AgentVm } from "agents.slint";
import { HostKeyRefusedPage, CouldntConnectPage, ConnectVm } from "connect_pages.slint";
import { SnippetsPage } from "snippets_page.slint";
import { HistoryVm, PaletteVm, PaletteRowData } from "extras.slint";
import { SnippetsBridge, SnippetRow, GoogleFontsBridge, GoogleFontRow, ChipRow } from "extras_bridge.slint";

import "../../../assets/fonts/CascadiaMono-Regular.ttf";
import "../../../assets/fonts/CascadiaMono-Bold.ttf";
import "../../../assets/fonts/CascadiaCode-Regular.ttf";
import "../../../assets/fonts/CascadiaCode-Bold.ttf";
import "../../../../apple/TetherKit/Sources/TetherKit/Resources/Fonts/JetBrainsMono-Regular.ttf";
import "../../../../apple/TetherKit/Sources/TetherKit/Resources/Fonts/JetBrainsMono-Bold.ttf";
import "../../../../apple/TetherKit/Sources/TetherKit/Resources/Fonts/MonaspaceNeon-Regular.otf";
import "../../../../apple/TetherKit/Sources/TetherKit/Resources/Fonts/MonaspaceNeon-Bold.otf";
import "../../../../apple/TetherKit/Sources/TetherKit/Resources/Fonts/MonaspaceRadon-Regular.otf";
import "../../../../apple/TetherKit/Sources/TetherKit/Resources/Fonts/MonaspaceRadon-Bold.otf";
import "../../../../apple/TetherKit/Sources/TetherKit/Resources/Fonts/MapleMono-Regular.ttf";
import "../../../../apple/TetherKit/Sources/TetherKit/Resources/Fonts/MapleMono-Bold.ttf";
import "../../../../apple/TetherKit/Sources/TetherKit/Resources/Fonts/ComicMono.ttf";
import "../../../../apple/TetherKit/Sources/TetherKit/Resources/Fonts/ComicMono-Bold.ttf";

export { Tokens } from "tokens.slint";
export { PageKind, AppBridge, HomeBridge, MachineCard, KeyCard, ServerFormBridge, KeyFormBridge, SettingsBridge, PickerBridge, SchemeRow, FontRow, SshImportBridge, ImportRow } from "bridge.slint";
export { TerminalPage, TerminalVm, TermTab } from "terminal.slint";
export { AgentVm, AgentQuestionRow, AgentOption } from "agents.slint";
export { GitVm, GitRowVm, DiffLineVm, CheckVm, MethodVm, MdLinkVm, MdItemVm } from "git.slint";
export { ChatVm, ChatRowVm, ChatEntryVm, ChatImageVm, ChatTabVm, ChatTaskVm, PaletteItemVm, AttachmentVm, PermOptionVm, QChoiceVm, QFieldVm, CtlChoiceVm, CtlOptionVm, CtlCommandVm, SavedSessionVm, NcMenuVm, NcChoiceVm } from "chat.slint";
export { HostKeyRefusedPage, CouldntConnectPage, ConnectVm } from "connect_pages.slint";
export { HistoryVm, PaletteVm, PaletteRowData } from "extras.slint";
export { SnippetsBridge, SnippetRow, GoogleFontsBridge, GoogleFontRow, ChipRow } from "extras_bridge.slint";

export component AppWindow inherits Window {
    in property <string> window-title: "Tether";
    title: root.window-title;
    icon: @image-url("../../../assets/icons/tether-256.png");
    min-width: 640px;
    min-height: 420px;
    preferred-width: 1040px;
    preferred-height: 680px;
    background: Tokens.background;
    default-font-family: Tokens.ui-font;

    property <bool> dark-scene: Tokens.dark;
    init => {
        Palette.color-scheme = Tokens.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-scene => {
        Palette.color-scheme = self.dark-scene ? ColorScheme.dark : ColorScheme.light;
    }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape && AppBridge.escape()) { return accept; }
            reject
        }
        Rectangle { background: Tokens.background; }
        if AppBridge.page == PageKind.home: Reveal { rise: 6px; HomePage { } }
        if AppBridge.page == PageKind.server-form: Reveal { rise: 6px; ServerFormPage { } }
        if AppBridge.page == PageKind.ssh-import: Reveal { rise: 6px; SshImportPage { } }
        if AppBridge.page == PageKind.key-generate: Reveal { rise: 6px; KeyGeneratePage { } }
        if AppBridge.page == PageKind.key-import || AppBridge.page == PageKind.key-paste: Reveal { rise: 6px; KeyMaterialPage { } }
        if AppBridge.page == PageKind.settings: Reveal { rise: 6px; SettingsPage { } }
        if AppBridge.page == PageKind.scheme-picker: Reveal { rise: 6px; SchemePickerPage { } }
        if AppBridge.page == PageKind.font-picker: Reveal { rise: 6px; FontPickerPage { } }
        if AppBridge.page == PageKind.terminal: Reveal { rise: 6px; TerminalPage { } }
        if AppBridge.page == PageKind.host-key-refused: Reveal { rise: 6px; HostKeyRefusedPage { } }
        if AppBridge.page == PageKind.couldnt-connect: Reveal { rise: 6px; CouldntConnectPage { } }
        if AppBridge.page == PageKind.snippets: Reveal { rise: 6px; SnippetsPage { } }
        if AppBridge.dialog-open: ConfirmDialog {
            title: AppBridge.dialog-title;
            body: AppBridge.dialog-body;
            extra: AppBridge.dialog-extra;
            action: AppBridge.dialog-action;
            confirmed => { AppBridge.dialog-confirmed(); }
            cancelled => { AppBridge.dialog-cancelled(); }
        }
    }
}
